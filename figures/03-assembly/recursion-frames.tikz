\begin{tikzpicture}[x=1mm, y=1mm]

  \node[box, minimum width=105mm, minimum height=12mm, anchor=west, align=left] (f3) at (0, 0)
    {\textbf{fact(3)}\quad\texttt{ra -> main}\quad\texttt{s0 = значение main}};
  \node[box, minimum width=105mm, minimum height=12mm, anchor=west, align=left] (f2) at (0, -16)
    {\textbf{fact(2)}\quad\texttt{ra -> fact(3)}\quad\texttt{s0 = 3}};
  \node[ghost, minimum width=105mm, minimum height=12mm, anchor=west, align=left] (f1) at (0, -32)
