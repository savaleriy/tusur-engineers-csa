  \draw[arr] ([xshift=10mm]f3.south) -- ([xshift=10mm]f2.north);
  \draw[arr] ([xshift=10mm]f2.south) -- ([xshift=10mm]f1.north);

  \draw[arr, draw=muted] (-7, 5) -- (-7, -37)
    node[midway, left=1mm, lbl, rotate=90] {стек растет вниз};

