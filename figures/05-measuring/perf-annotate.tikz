\begin{tikzpicture}[x=1mm, y=1mm]

  \node[font=\scriptsize, text=muted, anchor=west] at (0, 6) {инструкция};
  \node[font=\scriptsize, text=muted, anchor=west] at (55, 6) {доля сэмплов};

  \foreach \i/\ins/\pct/\w in {%
    0/{\texttt{mov rax, [rdi]}}/0.8/1,
    1/{\texttt{mov rdx, [rax+8]}}/58.4/35,
    2/{\texttt{add rdx, 1}}/0.4/1,
    3/{\texttt{cmp rdx, rsi}}/0.2/1,
    4/{\texttt{jne .L3}}/12.1/7,
    5/{\texttt{mov [rdi], rdx}}/0.3/1}
  {
    \node[font=\ttfamily\scriptsize, anchor=west] at (0, {-\i * 7}) {\ins};
    \fill[accent!25] (55, {-\i * 7 - 2}) rectangle ({55 + \w}, {-\i * 7 + 2});
    \node[font=\scriptsize, text=muted, anchor=west] at ({55 + \w + 2}, {-\i * 7}) {\pct\%};
  }

  \node[font=\scriptsize, text=accentb, anchor=west] at (0, -46) {горячая загрузка: сэмпл приписан следующей инструкции};

\end{tikzpicture}
