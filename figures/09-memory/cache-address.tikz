  \node[font=\scriptsize, text=muted] at (87, 7) {5 \ldots 0};

  \node[font=\scriptsize, text=muted] at (30, -7) {20 бит};
  \node[font=\scriptsize, text=muted] at (69, -7) {6 бит};
