\begin{tikzpicture}[x=1mm, y=1mm, font=\small]
  \tikzset{
    av/.style={draw=accent, thick, fill=accent!16!mixbg},
    bv/.style={draw=accentb, thick, fill=accentb!16!mixbg},
    acc/.style={draw=fg, thick, fill=boxfill},
    hdr/.style={font=\small\bfseries},
    note/.style={font=\scriptsize, text=muted, align=center},
  }

  % A vector: 16 floats, two ymm
  \draw[av] (0,0) rectangle (14,40);
  \draw[fg, thick] (0,20) -- (14,20);
  \node[hdr] at (7,45) {$A$};
  \node[note] at (7,30) {$a_0 \ldots a_7$};
  \node[note] at (7,10) {$a_8 \ldots a_{15}$};
  \node[note] at (-5,30) {$2$ \texttt{ymm}};

  % B row: 6 broadcasts
  \foreach \j in {0,...,5} {
    \draw[bv] (25+10*\j,45) rectangle (35+10*\j,55);
    \node[note] at (30+10*\j,50) {$b_{\j}$};
  }
  \node[hdr] at (55,59) {$B$: 6 broadcast};

  % C tile: 16 rows x 6 columns, each column split into two 8-float halves
  \foreach \j in {0,...,5} {
    \draw[acc] (25+10*\j,0) rectangle (35+10*\j,40);
    \draw[fg] (25+10*\j,20) -- (35+10*\j,20);
    \node[note] at (30+10*\j,-3) {$j=\j$};
    \node[note] at (30+10*\j,30) {$C_{0..7}$};
    \node[note] at (30+10*\j,10) {$C_{8..15}$};
  }
  \node[hdr, anchor=west] at (88,20) {$C$};

  % arrows
  \draw[-{Stealth}, thick, accent] (15,30) -- (24,30) node[midway, above, note] {load};

  \node[note, anchor=west] at (0,-14)
    {на каждый $k$: 2 загрузки $A$, 6 broadcast $B$, 12 FMA};
  \node[note, anchor=west] at (0,-21)
    {$12$ \texttt{ymm} для $C$ + $2$ \texttt{ymm} для $A$ + $1$ \texttt{ymm} для $B$ = $15$};

\end{tikzpicture}